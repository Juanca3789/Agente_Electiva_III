# Ejemplo systemd para Flask tras nginx.
# sudo cp deploy/electiva.service.example /etc/systemd/system/electiva.service
# Edita rutas, luego: sudo systemctl daemon-reload && sudo systemctl enable --now electiva

[Unit]
Description=Electiva III backend (Flask + Jev)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/electiva/backend
EnvironmentFile=/opt/electiva/.env
ExecStart=/opt/electiva/backend/.venv/bin/python app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
