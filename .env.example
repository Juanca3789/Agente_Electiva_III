# Copiar a la raíz del repo: cp .env.example .env
# Nginx lee FRONTEND_ROOT; systemd/Flask leen el resto.

# --- Público ---
PUBLIC_HOST=_
# PUBLIC_HOST=tu-dominio.edu.co

# --- Rutas en el servidor (AWS EC2, etc.) ---
APP_ROOT=/opt/electiva
FRONTEND_ROOT=/opt/electiva/frontend/dist
BACKEND_ROOT=/opt/electiva/backend
BACKEND_DATA_DIR=/opt/electiva/backend/data

# --- Flask (solo loopback; nginx expone /api y /health) ---
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=0

# --- Upload PDF (debe coincidir con client_max_body_size en nginx) ---
MAX_UPLOAD_MB=10
